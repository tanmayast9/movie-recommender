        ],
        "url": {
          "raw": "{{base_url}}/api/suggest-live?mood=mind-bending&language=en&min_rating=7.5",
          "host": ["{{base_url}}"],
          "path": ["api", "suggest-live"],
          "query": [
            { "key": "mood", "value": "mind-bending" },
