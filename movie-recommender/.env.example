# Flask Application Secret Key for session signing
SECRET_KEY=replace_with_a_unique_random_secret_key

# External TMDB API Key (Get a free key from https://www.themoviedb.org/settings/api)
# CineMatch gracefully falls back to a verified offline catalogue of real TMDB movies if not provided
TMDB_API_KEY=your_tmdb_api_key_here

# Database URL (Defaults to local SQLite cinematch.db)
DATABASE_URL=sqlite:///cinematch.db

# Server port (default 5000)
PORT=5000

# Cache timeout in seconds (default 3600 = 1 hour)
API_CACHE_TIMEOUT=3600
